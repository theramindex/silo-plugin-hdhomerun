  "metadata": {
    "display_name": "HDHomeRun for Silo",
    "summary": "Live TV from physical and emulated HDHomeRun tuners."
  },
  "presentation": {
    "display_name": "HDHomeRun for Silo",
    "summary": "Live TV from physical and emulated HDHomeRun tuners.",
    "description_markdown": "Connect multiple HDHomeRun HTTP endpoints with per-device tuner limits, explicit station failover, and XMLTV or SiliconDust guide data. Uses the Ramindex Silo Live TV contract. DRM-protected channels and DVR are not supported.",
    "setup_markdown": "Install on the Ramindex Silo fork. Open HDHomeRun Devices and add endpoint addresses reachable from the server. Configure a guide for each endpoint if desired. Browser playback requires the loopback stream relay in the companion Silo fork.",
    "homepage_url": "https://github.com/theramindex/silo-plugin-hdhomerun",
    "source_url": "https://github.com/theramindex/silo-plugin-hdhomerun",
    "support_url": "https://github.com/theramindex/silo-plugin-hdhomerun/issues",
    "changelog_url": "https://github.com/theramindex/silo-plugin-hdhomerun/releases",
    "publisher_name": "Ramindex",
    "publisher_url": "https://github.com/theramindex",
    "license_spdx": "AGPL-3.0-only"
  },
